# Disable Apache MultiViews & Directory Listing to prevent HTTP 406 "Not Acceptable!" errors
Options -MultiViews -Indexes

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Prevent ModSecurity WAF false-positive 406 blocks on legitimate crawlers (SemrushBot, Googlebot, etc.)
<IfModule mod_security.c>
  SecFilterEngine Off
  SecFilterScanPOST Off
</IfModule>

# Ensure proper default document and charset
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Custom error documents to ensure Apache never serves raw "<title>Not Acceptable!</title>"
ErrorDocument 406 /index.html
ErrorDocument 404 /index.html
ErrorDocument 410 "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='robots' content='noindex, nofollow'><title>410 Gone | ISI Security</title></head><body><h1>410 Gone</h1><p>The requested URL has been permanently removed.</p><p><a href='https://www.isisecurity.in/'>Return to ISI Security</a></p></body></html>"

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # =========================================================================
  # PHASE 6: CANONICALIZATION (Single-Hop 301 to https://www.isisecurity.in)
  # Forces http://isisecurity.in, https://isisecurity.in, http://www.isisecurity.in
  # =========================================================================
  RewriteCond %{HTTP_HOST} ^isisecurity\.in$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.isisecurity\.in$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.isisecurity\.in$ [NC]
  RewriteRule ^ https://www.isisecurity.in%{REQUEST_URI} [L,R=301]

  # =========================================================================
  # PHASE 3: PERMANENTLY REMOVED SPAM URL (HTTP 410 GONE)
  # =========================================================================
  RewriteRule ^need-protection-money-properties-vip-escort-services(/.*)?$ - [G,L,NC]

  # =========================================================================
  # LEGACY 301 REDIRECTS (Aligned with App.tsx routes)
  # =========================================================================
  RewriteRule ^services/skill-development-manpower/?$ https://www.isisecurity.in/academy [L,R=301,NC]
  RewriteRule ^mobile-security-services-chennai-crime-prevention/?$ https://www.isisecurity.in/services/security [L,R=301,NC]
  RewriteRule ^integrated-?services/thank-you/?$ https://www.isisecurity.in/lp/facility-management/thank-you [L,R=301,NC]
  RewriteRule ^(services/)?integrated-?services/?$ https://www.isisecurity.in/lp/facility-management [L,R=301,NC]
  RewriteRule ^sales-?inquiry/?$ https://www.isisecurity.in/lp/facility-management [L,R=301,NC]

  # =========================================================================
  # SPA ROUTING FALLBACK (All valid routes return HTTP 200 with index.html)
  # =========================================================================
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vary header for proper CDN/crawler caching
  Header append Vary Accept-Encoding
  Header unset X-Powered-By

  # HSTS & Security Headers (Phase 6 & Phase 8)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
