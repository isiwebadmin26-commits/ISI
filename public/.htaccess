# SENIOR ENGINEER CONFIGURATION
# Optimized for cPanel/Apache React Deployments

# 1. Stability & Standards
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Canonical Host & HTTPS Redirection (301 Permanent Redirect)
  # Step A: Force HTTPS for all non-local domains (handles both www and non-www, proxy-aware)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Step B: Canonical redirect bare domain to www.isisecurity.in
  RewriteCond %{HTTP_HOST} ^isisecurity\.in$ [NC]
  RewriteRule ^(.*)$ https://www.isisecurity.in/$1 [R=301,L]

  # 3. SPA Routing (React Router)
  RewriteRule ^index\.html$ - [L]

  # Don't rewrite actual files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route client-side SPA URLs to index.html (ignore static assets with extensions)
  RewriteCond %{REQUEST_URI} !\.(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|map|json|xml|txt|webp|mp4|webm)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>

# Fallback for 406 Not Acceptable
ErrorDocument 406 /index.html

<IfModule mod_headers.c>
  # 4. Critical Cache Control for HTML Entry Point
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache Assets aggressively & Allow Cross-Origin (includes webp, mp4, webm, fonts)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 5. Security (Safe Mode)
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "frame-ancestors 'self';"
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>
